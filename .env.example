POSTGRES_DB=flash
POSTGRES_USER=flash
POSTGRES_PASSWORD=replace-with-a-local-development-password
APP_PORT=3000
DATABASE_URL="postgresql://flash:replace-with-a-local-development-password@127.0.0.1:5432/flash"
FLASH_DEV_IDENTITY=1
FLASH_DEV_USER_ID=dev_owner
FLASH_DEV_USER_EMAIL=owner@flash.local
FLASH_DEV_SEED=1
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
LOG_LEVEL=info
RESEND_API_KEY=replace-with-resend-send-only-key
RESEND_FROM_EMAIL="Flash <onboarding@resend.dev>"
RESEND_VERIFICATION_TEMPLATE_ID=replace-with-published-template-id
